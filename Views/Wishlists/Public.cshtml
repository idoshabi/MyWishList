@model MyWishList.Web.Models.ViewModels.WishlistDetailsViewModel
@{
    ViewData["Title"] = Model.WishlistName;
}

<section class="public-header">
    <div class="container">
        <div class="badge-type mb-2" style="background:rgba(255,255,255,0.15);color:#fff;font-size:0.85rem;">@Model.RegistryType</div>
        <h1 class="display-title mb-2" style="font-size:clamp(1.5rem,4vw,2.5rem);">@Model.WishlistName</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p style="color:rgba(255,255,255,0.8);max-width:560px;margin:0 auto;">@Model.Description</p>
        }
        @if (Model.EventDate.HasValue)
        {
            var days = Model.EventDate.Value.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
            <div class="mt-3">
                <span class="countdown-badge" style="background:rgba(255,255,255,0.15);color:#fff;">
                    <i class="bi bi-calendar-event"></i>
                    @Model.EventDate.Value.ToString("MMMM d, yyyy")
                    @if (days > 0)
                    {
                        <span>— @days days away</span>
                    }
                </span>
            </div>
        }
    </div>
</section>

<section class="section-sm">
    <div class="container" style="max-width:800px;">
        <!-- Cash Fund -->
        @if (Model.CashFundGoal.HasValue && Model.CashFundGoal > 0)
        {
            var pct = Model.CashFundGoal > 0 ? Math.Min(100, (int)(Model.CashFundRaised / Model.CashFundGoal.Value * 100)) : 0;
            <div class="card card-body mb-4 text-center" style="border:none;background:var(--gray-50);">
                <h3 class="h6 mb-2"><i class="bi bi-cash-stack me-1 text-primary"></i>Cash Fund</h3>
                <div class="d-flex justify-content-center gap-4 mb-2">
                    <div>
                        <div class="fw-bold fs-5" style="color:var(--primary);">$@Model.CashFundRaised.ToString("N0")</div>
                        <small class="text-muted">raised</small>
                    </div>
                    <div>
                        <div class="fw-bold fs-5">$@Model.CashFundGoal.Value.ToString("N0")</div>
                        <small class="text-muted">goal</small>
                    </div>
                </div>
                <div class="progress mx-auto" style="height:10px;border-radius:5px;max-width:400px;">
                    <div class="progress-bar" role="progressbar" style="width:@(pct)%;background:var(--primary);border-radius:5px;"></div>
                </div>
            </div>
        }

        <h2 class="h5 mb-3">Gift List <span class="text-muted fw-normal" style="font-size:0.9rem;">(@Model.Items.Count items)</span></h2>

        @if (!Model.Items.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-box-seam"></i></div>
                <h3 class="h6">No items on this list yet</h3>
                <p class="text-muted">Check back soon — the list owner is still adding gifts.</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var item in Model.Items)
                {
                    var statusClass = item.IsPurchased ? "purchased" : item.IsReserved ? "reserved" : "";
                    <div class="item-card @statusClass">
                        <div class="item-thumb">
                            @if (item.IsPurchased) { <i class="bi bi-check-circle-fill" style="color:var(--success);"></i> }
                            else if (item.IsReserved) { <i class="bi bi-bookmark-fill" style="color:var(--accent);"></i> }
                            else { <i class="bi bi-gift" style="color:var(--gray-400);"></i> }
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>@item.ProductName</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Merchant))
                                    {
                                        <span class="text-muted ms-2" style="font-size:0.8rem;">from @item.Merchant</span>
                                    }
                                </div>
                                <div class="d-flex gap-1">
                                    @if (!string.IsNullOrWhiteSpace(item.Link))
                                    {
                                        <a href="@item.Link" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary" style="font-size:0.8rem;">Buy</a>
                                    }
                                </div>
                            </div>
                            <div class="mt-1" style="font-size:0.85rem;">
                                @if (item.IsPurchased)
                                {
                                    <span style="color:var(--success);"><i class="bi bi-check-circle-fill me-1"></i>Purchased</span>
                                }
                                else if (item.IsReserved)
                                {
                                    <span style="color:var(--accent-dark);"><i class="bi bi-bookmark-fill me-1"></i>Reserved</span>
                                }
                                else
                                {
                                    <span class="text-muted"><i class="bi bi-hand-index me-1"></i>Available</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
<div style="height:3rem;"></div>
