@model MyWishList.Web.Models.ViewModels.WishlistDetailsViewModel
@{
    ViewData["Title"] = Model.WishlistName;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.WishlistName</h1>
        <p class="text-muted mb-0">Add and manage items in this wishlist.</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
</div>

@if (TempData["FeedbackMessage"] is string feedbackMessage)
{
    var feedbackType = TempData["FeedbackType"] as string ?? "info";
    <div class="alert alert-@feedbackType" role="alert">@feedbackMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">Add Item</h2>
        <form asp-controller="Wishlists" asp-action="AddItem" asp-route-id="@Model.WishlistId" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <input name="ProductName" class="form-control" placeholder="Product name" required />
            </div>
            <div class="col-md-6">
                <input name="Link" class="form-control" placeholder="Product link (optional)" />
            </div>
            <div class="col-md-6">
                <input name="Merchant" class="form-control" placeholder="Merchant (optional)" />
            </div>
            <div class="col-md-3">
                <input name="Type" class="form-control" placeholder="Type (optional)" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Add Item</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">No items yet in this wishlist.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Merchant</th>
                    <th>Type</th>
                    <th>Link</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@(item.Merchant ?? "-")</td>
                        <td>@(item.Type ?? "-")</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Link))
                            {
                                <a href="@item.Link" target="_blank" rel="noopener noreferrer">Open</a>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
