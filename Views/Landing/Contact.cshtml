@{
    ViewData["Title"] = "Contact Us";
}

<section class="hero" style="padding:4rem 0;">
    <div class="container text-center" style="position:relative;z-index:1;">
        <h1 class="display-title mb-2">Get In Touch</h1>
        <p class="lead mx-auto">Have a question, feedback, or partnership idea? We'd love to hear from you.</p>
    </div>
</section>

<section class="section">
    <div class="container" style="max-width:600px;">
        <div class="card card-body p-4">
            <div class="mb-3">
                <label class="form-label fw-semibold">Your Name</label>
                <input type="text" class="form-control" placeholder="Jane Smith" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Email Address</label>
                <input type="email" class="form-control" placeholder="jane@example.com" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Subject</label>
                <select class="form-select">
                    <option>General Inquiry</option>
                    <option>Bug Report</option>
                    <option>Feature Request</option>
                    <option>Partnership</option>
                    <option>Press</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Message</label>
                <textarea class="form-control" rows="5" placeholder="Tell us what's on your mind..."></textarea>
            </div>
            <button type="button" class="btn btn-cta" onclick="alert('Thank you! We\'ll get back to you soon.');">Send Message</button>
        </div>
        <div class="text-center mt-4 text-muted">
            <p class="mb-1"><i class="bi bi-envelope me-1"></i> support@mywishlist.com</p>
            <p class="mb-0"><i class="bi bi-geo-alt me-1"></i> San Francisco, CA</p>
        </div>
    </div>
</section>
