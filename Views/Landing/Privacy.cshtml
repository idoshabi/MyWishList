@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="section">
    <div class="container" style="max-width:750px;">
        <h1 class="h2 mb-4">Privacy Policy</h1>
        <p class="text-muted mb-4">Last updated: @DateTime.Now.ToString("MMMM yyyy")</p>

        <h3 class="h5">Information We Collect</h3>
        <p class="text-muted">We collect information you provide when creating an account (name, email, date of birth) and data you add to your wish lists (item names, links, notes). We also collect standard usage data like page views and device type.</p>

        <h3 class="h5">How We Use Your Information</h3>
        <p class="text-muted">Your information is used to provide and improve the MyWishList service, personalize your experience, and communicate with you about your account and lists.</p>

        <h3 class="h5">Sharing & Visibility</h3>
        <p class="text-muted">Public lists are visible to anyone with the share link or who finds them via search. Private lists are only accessible to you. We do not sell your personal information to third parties.</p>

        <h3 class="h5">Data Security</h3>
        <p class="text-muted">We use industry-standard security measures including encrypted connections, hashed passwords, and secure infrastructure to protect your data.</p>

        <h3 class="h5">Contact</h3>
        <p class="text-muted">Questions about this policy? <a asp-controller="Landing" asp-action="Contact">Contact us</a>.</p>
    </div>
</section>
