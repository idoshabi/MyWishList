@model MyWishList.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["HideNav"] = true;
    ViewData["HideFooter"] = true;
}

<div class="auth-wrapper">
    <div>
        <div class="text-center mb-4">
            <a asp-controller="Landing" asp-action="Index" class="nav-brand text-decoration-none" style="font-size:1.8rem;">My<span>WishList</span></a>
        </div>
        <div class="auth-card">
            <h1 class="h4 fw-bold text-center mb-1">Welcome back</h1>
            <p class="text-muted text-center mb-4" style="font-size:0.9rem;">Sign in to manage your wish lists</p>

            <div class="d-flex gap-2 mb-3">
                <button type="button" class="social-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                    Google
                </button>
                <button type="button" class="social-btn">
                    <i class="bi bi-apple" style="font-size:1.1rem;"></i>
                    Apple
                </button>
            </div>

            <div class="divider-text my-3">or continue with email</div>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="font-size:0.9rem;display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none");"></div>

                <div class="mb-3">
                    <label asp-for="UsernameOrEmail" class="form-label">Username or Email</label>
                    <input asp-for="UsernameOrEmail" class="form-control" placeholder="you@example.com" autofocus />
                    <span asp-validation-for="UsernameOrEmail" class="text-danger" style="font-size:0.85rem;"></span>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <label asp-for="Password" class="form-label">Password</label>
                        <a href="#" class="text-decoration-none" style="font-size:0.85rem;color:var(--primary);">Forgot password?</a>
                    </div>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:0.85rem;"></span>
                </div>

                <button type="submit" class="btn btn-cta w-100 mb-3">Sign In</button>
            </form>

            <p class="text-center text-muted mb-0" style="font-size:0.9rem;">
                Don't have an account? <a asp-action="Register" class="text-decoration-none fw-semibold" style="color:var(--primary);">Create one</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
