<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — MyWishList" : "MyWishList — One List. Every Store. Every Occasion.")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (ViewData["HideNav"] is not true)
    {
        <nav class="site-nav" id="siteNav">
            <div class="container">
                <div class="d-flex align-items-center justify-content-between py-2">
                    <a class="nav-brand" asp-controller="Landing" asp-action="Index">My<span>WishList</span></a>

                    <button class="btn d-lg-none border-0 fs-5" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-label="Menu">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="d-none d-lg-flex align-items-center gap-1">
                        <a class="nav-link" asp-controller="Landing" asp-action="Find">Find a List</a>
                        <a class="nav-link" asp-controller="Landing" asp-action="HowItWorks">How It Works</a>
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Occasions</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Landing" asp-action="Occasion" asp-route-type="Wedding">Wedding</a></li>
                                <li><a class="dropdown-item" asp-controller="Landing" asp-action="Occasion" asp-route-type="Baby">Baby</a></li>
                                <li><a class="dropdown-item" asp-controller="Landing" asp-action="Occasion" asp-route-type="Birthday">Birthday</a></li>
                                <li><a class="dropdown-item" asp-controller="Landing" asp-action="Occasion" asp-route-type="Housewarming">Housewarming</a></li>
                                <li><a class="dropdown-item" asp-controller="Landing" asp-action="Occasion" asp-route-type="Nonprofit">Charity / Nonprofit</a></li>
                            </ul>
                        </div>
                        <a class="nav-link" asp-controller="Landing" asp-action="Features">Features</a>
                    </div>

                    <div class="d-none d-lg-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2-fill me-1"></i>Dashboard</a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Sign In</a>
                            <a class="btn btn-cta btn-sm" asp-controller="Account" asp-action="Register">Get Started</a>
                        }
                    </div>
                </div>
            </div>
        </nav>

        <div class="offcanvas offcanvas-end" tabindex="-1" id="mobileMenu">
            <div class="offcanvas-header">
                <span class="nav-brand">My<span>WishList</span></span>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column gap-2">
                <a class="nav-link" asp-controller="Landing" asp-action="Find">Find a List</a>
                <a class="nav-link" asp-controller="Landing" asp-action="HowItWorks">How It Works</a>
                <a class="nav-link" asp-controller="Landing" asp-action="Occasion" asp-route-type="Wedding">Wedding Registry</a>
                <a class="nav-link" asp-controller="Landing" asp-action="Occasion" asp-route-type="Baby">Baby Registry</a>
                <a class="nav-link" asp-controller="Landing" asp-action="Occasion" asp-route-type="Birthday">Birthday Gift List</a>
                <a class="nav-link" asp-controller="Landing" asp-action="Features">Features</a>
                <hr>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-cta" asp-controller="Home" asp-action="Index">Dashboard</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary w-100">Logout</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Sign In</a>
                    <a class="btn btn-cta" asp-controller="Account" asp-action="Register">Get Started</a>
                }
            </div>
        </div>
    }

    @RenderBody()

    @if (ViewData["HideFooter"] is not true)
    {
        <footer class="site-footer">
            <div class="container">
                <div class="row g-4">
                    <div class="col-lg-4 mb-3">
                        <a class="footer-brand text-decoration-none" href="/">My<span style="color:var(--primary-light)">WishList</span></a>
                        <p class="mt-2 mb-0" style="max-width:300px;">One universal wish list for every occasion. Add gifts from any store, share one link, and celebrate together.</p>
                    </div>
                    <div class="col-6 col-lg-2">
                        <h5>Product</h5>
                        <div class="d-flex flex-column gap-2">
                            <a asp-controller="Landing" asp-action="Features">Features</a>
                            <a asp-controller="Landing" asp-action="HowItWorks">How It Works</a>
                            <a asp-controller="Landing" asp-action="Find">Find a List</a>
                        </div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <h5>Occasions</h5>
                        <div class="d-flex flex-column gap-2">
                            <a asp-controller="Landing" asp-action="Occasion" asp-route-type="Wedding">Wedding</a>
                            <a asp-controller="Landing" asp-action="Occasion" asp-route-type="Baby">Baby</a>
                            <a asp-controller="Landing" asp-action="Occasion" asp-route-type="Birthday">Birthday</a>
                        </div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <h5>Company</h5>
                        <div class="d-flex flex-column gap-2">
                            <a asp-controller="Landing" asp-action="About">About</a>
                            <a asp-controller="Landing" asp-action="Contact">Contact</a>
                            <a asp-controller="Landing" asp-action="Privacy">Privacy</a>
                        </div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <h5>Connect</h5>
                        <div class="d-flex gap-3 fs-5">
                            <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="#" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
                        </div>
                    </div>
                </div>
                <div class="footer-divider"></div>
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                    <small>&copy; @DateTime.Now.Year MyWishList. All rights reserved.</small>
                    <div class="d-flex gap-3">
                        <a href="#"><small>Terms of Service</small></a>
                        <a asp-controller="Landing" asp-action="Privacy"><small>Privacy Policy</small></a>
                    </div>
                </div>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.addEventListener('scroll', function() {
            document.getElementById('siteNav')?.classList.toggle('scrolled', window.scrollY > 10);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
